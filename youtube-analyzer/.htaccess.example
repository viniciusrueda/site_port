# Copie para .htaccess no servidor e preencha. O .htaccess real fica fora do git.
SetEnv YOUTUBE_API_KEY "SUA_CHAVE_YOUTUBE"
SetEnv GEMINI_API_KEY "SUA_CHAVE_GEMINI"
SetEnv GROQ_API_KEY "SUA_CHAVE_GROQ"
SetEnv YTA_IP_SALT "um-texto-aleatorio-e-longo"
SetEnv YTA_CRON_TOKEN "outro-texto-aleatorio-e-longo"

SetEnv DB_HOST "localhost"
SetEnv DB_NAME "SEU_BANCO"
SetEnv DB_USER "SEU_USUARIO"
SetEnv DB_PASS "SUA_SENHA"
